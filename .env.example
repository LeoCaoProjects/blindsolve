# Fill these only from the dedicated BlindSolve Supabase project. Never use another project's values.
SUPABASE_URL=https://YOUR-BLINDSOLVE-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_BLINDSOLVE_PROJECT_ANON_KEY
VITE_SUPABASE_URL=https://YOUR-BLINDSOLVE-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_BLINDSOLVE_PROJECT_ANON_KEY
CORS_ORIGINS=http://localhost:5173

# Supabase Edge Function secrets (set with `supabase secrets set`; never prefix with VITE_)
APP_URL=http://localhost:5173
WCA_CLIENT_ID=YOUR_WCA_OAUTH_APPLICATION_ID
WCA_CLIENT_SECRET=YOUR_WCA_OAUTH_CLIENT_SECRET
