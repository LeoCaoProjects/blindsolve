{
  "name": "blindsolve",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-seo.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:seo": "node scripts/seo.check.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.57.4",
    "cubing": "^0.63.7",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.4.3",
    "lucide-react": "^0.522.0",
    "lz-string": "1.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.44.1",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
